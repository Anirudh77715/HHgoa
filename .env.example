# Copy this file to `.env` and fill in the real value.
# `.env` is gitignored — it must NEVER be committed.
#
#   copy .env.example .env      (Windows cmd)
#   Copy-Item .env.example .env (PowerShell)

# --- Gemini (Google AI Studio) ---
# Get a free key: https://aistudio.google.com/apikey
# Free tier: ~1500 req/day. Flash-Lite = 30 RPM, Flash = 15 RPM.
GEMINI_API_KEY=

# Generation model. Flash-Lite is chosen for BOTH lower latency and 2x the
# free-tier RPM of Flash. Override only if you have a paid key.
GEMINI_MODEL=gemini-2.5-flash-lite

# --- harness / rate limiting ---
# Client-side token bucket. Keep at or below your real console quota so we
# pace requests instead of retry-storming into 429s.
GEN_RPM_LIMIT=30
GEN_TIMEOUT_MS=8000
GEN_MAX_RETRIES=3

# --- retrieval ---
# NOT the -v1.5 variant: fastembed ships that one int8-quantized, and it
# measures 153ms p50 per query here versus 6.7ms for this non-quantized model
# — 23x slower. See app/index/embed.py and bench/reports/.
EMBED_MODEL=BAAI/bge-small-en
TOP_K=5

# dense | hybrid. Hybrid fuses BM25 into the ranking with RRF.
#
# On aggregate the two are indistinguishable (prec@1 0.676 -> 0.703, one query
# net of 37, bootstrap CIs almost fully overlapping). Hybrid is the default for
# an asymmetry, not an average: dense returned "Registration Ends" as the top
# passage for "when does registration begin", and because both passages then
# land in context the groundedness check passes the wrong answer. The 3 queries
# hybrid demotes all keep their gold doc inside the top 5.
# Costs ~1ms p50. See bench/bench_hybrid.py.
RETRIEVAL_MODE=hybrid
# Standard RRF constant, kept untuned on purpose — sweeping it on the same 37
# queries used to evaluate would manufacture a number that does not generalise.
RRF_K=60

# Cosine floor below which we skip the LLM call entirely. Applied to the best
# DENSE cosine even in hybrid mode, since that is what was calibrated.
#
# CALIBRATED, NOT GUESSED (py -m bench.calibrate). 0.8167 is the highest cutoff
# that still keeps 37/37 answerable queries. Note the scale: bge cosines cluster
# in 0.79-0.87, so a "sensible-looking" value like 0.42 would gate nothing at all.
#
# IMPORTANT — this is a cost filter, not the guardrail. Measured on 48 labelled
# queries, this cutoff blocks only 5/11 must-refuse queries; 6 leak through,
# including "how many registrations were there in 2024". Blocking more would
# start costing real questions. No cutoff separates the populations, so the
# groundedness check on the generated answer is what actually prevents
# fabrication. Do not raise this number hoping to fix that.
#
# And know what groundedness does NOT cover before relying on it: it verifies
# specifics (numbers, months, amounts, URLs), not semantics. Four measured blind
# spots are catalogued in bench/guardrail_cases.yaml — run
# `py -m bench.bench_guardrails` to see them.
RETRIEVAL_MIN_SCORE=0.8167

# --- server ---
PORT=7860
LOG_LEVEL=info
